---

<nav class="nav">
  <div class="nav-title">
    <img src="/logo.png" alt="Logo" width="100" height="100" />
    <a href="#">Manaheim</a>
  </div>
  <div class="nav-links">
    <a href="#" class="nav-link">Univers</a>
    <a href="#" class="nav-link">Règles</a>
    <div class="search-container">
      <input type="text" class="search-input" placeholder="Rechercher..." />
    </div>
  </div>
</nav>

<style>
  .nav {
    background: var(--darkBlue-surface);
    padding: 0 var(--size-8);
    border-bottom: 1px solid var(--darkBlue-border);
    position: sticky;
    top: 0;
    z-index: var(--z-index-sticky);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .nav-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .nav-title a {
    font-size: var(--size-10);
    color: var(--gold-light);
    font-family: var(--title);
    text-decoration: none;
  }

  .nav-links {
    display: flex;
    gap: 2rem;
    align-items: center;
  }

  .nav-link {
    color: var(--light-text);
    font-family: var(--interface);
    text-decoration: none;
    font-weight: 500;
    transition: color 0.3s ease;
    text-transform: uppercase;
    letter-spacing: 1px;
    transition: all 1s ease;
    position: relative;
  }
  .nav-link:after {
    content: "";
    position: absolute;
    width: 0;
    height: 2px;
    bottom: -4px;
    left: 0;
    background: var(--gold-dark);
    transition: width 0.5s ease;
  }

  .nav-link:hover {
    color: var(--gold-dark);
  }

  .nav-link:hover:after {
    width: 100%;
  }

  .search-container {
    position: relative;
    margin-left: 2rem;
  }

  .search-input {
    background: var(--darkBlue-elevated);
    border: 1px solid var(--darkBlue-border);
    color: var(--light-text);
    padding: 0.5rem 1rem;
    border-radius: 50px;
    width: 200px;
    transition: all 0.5s ease;
    line-height: 1;
  }

  .search-input:focus {
    outline: none;
    border-color: var(--gold-primary);
    width: 250px;
  }

  .search-input::placeholder {
    color: var(--faint-text);
  }
</style>
